{
  "name": "edu-hackthon-tutor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/png.test.mjs test/learning.test.mjs test/assessment-adapter.test.mjs",
    "test:prototype": "node --test test/coach.test.mjs test/server.test.mjs",
    "probe:audio": "node --use-system-ca scripts/live-probe.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
