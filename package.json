{
  "name": "edu-hackthon-tutor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "preview": "node --use-system-ca presentation/demo-server.mjs",
    "preview:combined": "npm run discovery:build && npm run preview",
    "check": "node scripts/check.mjs",
    "test": "node --test test/png.test.mjs test/learning.test.mjs test/assessment-adapter.test.mjs test/preview.test.mjs test/profile-bridge.test.mjs",
    "test:preview:browser": "node --test test/preview-browser.test.mjs",
    "test:combined:browser": "node --test test/two-stage-browser.test.mjs",
    "test:prototype": "node --test test/coach.test.mjs test/server.test.mjs",
    "probe:audio": "node --use-system-ca scripts/live-probe.mjs",
    "discovery:dev": "npm --prefix app run dev -- --port 5173",
    "discovery:build": "npm --prefix app run build",
    "discovery:test": "npm --prefix app test",
    "discovery:test:browser": "npm --prefix app run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
